# ==============================================================================
# Bangladesh Telecom Intelligence — Environment Configuration Example
# Copy to `.env` for local customization. NEVER commit `.env` or real secrets.
#
# Loading behavior in current implementation:
# - `scripts/start_telecom_intel.sh` safely parses `.env` as literal KEY=VALUE
#   pairs (no shell execution) while preserving already-exported caller vars.
# - `bd_telecom_scraper/tavily/config.py` also auto-loads `.env` via its
#   built-in `load_dotenv_file()` helper.
# - When running `llm`, `api.server`, or `facebook` standalone outside the
#   launcher script, export any overrides in your shell environment first.
# ==============================================================================

# --- Local Ollama LLM Engine (strictly loopback: localhost / 127.0.0.1 / ::1) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
LLM_MAX_INPUT_CHARS=6000
LLM_TIMEOUT_SECONDS=120
LLM_BATCH_SIZE=10
LLM_MAX_RETRIES=2

# --- Local Refresh REST API & Dashboard Ports (loopback 127.0.0.1) ---
TELECOM_API_PORT=8000
STREAMLIT_SERVER_PORT=8501

# --- Optional: Tavily Search & Extract API (Free Tier: 1,000 credits/month) ---
# Leave blank to run without Tavily discovery; add your real key only in local `.env`.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_EXTRACT_DEPTH=basic
TAVILY_MAX_RESULTS=10
TAVILY_MIN_INTERVAL_HOURS=12
TAVILY_MONTHLY_CREDIT_BUDGET=800
TAVILY_TIMEOUT_SECONDS=25
TAVILY_EXTRACT_FALLBACK=true

# --- Optional: Meta Graph API v27.0 (for managed or PPCA-approved Facebook Pages) ---
# Leave blank to use Manual Public Content Ingestion only.
META_ACCESS_TOKEN=
